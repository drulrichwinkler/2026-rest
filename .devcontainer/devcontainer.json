{
  "name": "REST – Distributed Parcel System 2026",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "containerEnv": {
    "DATA_DIR": "${containerWorkspaceFolder}/loesung/data",
    "STAGING_DIR": "${containerWorkspaceFolder}/loesung/staging",
    "FILE_DATA_DIR": "${containerWorkspaceFolder}/loesung/file-data"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "humao.rest-client",
        "rangav.vscode-thunder-client",
        "Postman.postman-for-vscode",
        "tomoki1207.pdf"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.rulers": [88],
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/loesung/.venv/bin/python",
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
        "files.associations": { "*.http": "http" }
      }
    }
  },
  "forwardPorts": [8000, 8001],
  "portsAttributes": {
    "8000": { "label": "Parcel-Service", "onAutoForward": "notify" },
    "8001": { "label": "File-Service", "onAutoForward": "notify" }
  },
  "remoteUser": "vscode"
}
